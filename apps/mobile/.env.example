# ─────────────────────────────────────────────────────────────────────────────
# 주의: EXPO_PUBLIC_* 값은 전부 클라이언트 번들에 포함된다.
#       절대 secret(service role key, IDENTITY_HASH_SECRET 등)을 넣지 말 것.
#       보안 판단(dev-login 허용 등)은 서버 환경변수(APP_ENV 등)가 담당하며,
#       이 파일의 값은 UI 노출 여부 같은 편의 기능에만 영향을 준다.
#       환경별 값 목록: docs/environments.md
# ─────────────────────────────────────────────────────────────────────────────

# Supabase 프로젝트 (Settings → API) — anon key 는 public 이지만 환경별로 다르다.
#   local:      http://127.0.0.1:54321 + 로컬 anon key (supabase start 출력)
#   staging:    staging 프로젝트 URL/anon key
#   production: production 프로젝트 URL/anon key (staging 과 반드시 다른 프로젝트)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# DEVELOPMENT ONLY — 개발 편의 기능(테스트 로그인/본인확인 통과/얼굴 촬영 건너뛰기) 노출.
#   release 빌드(__DEV__=false)에서는 이 값이 1 이어도 항상 비활성화된다.
#   production 환경 설정(EAS 등)에는 이 변수를 아예 넣지 말 것.
EXPO_PUBLIC_DEV_LOGIN=1
