# Supabase 프로젝트 (Settings → API) — service key 는 서버 전용, 절대 공개 금지
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 관리자 페이지 로그인 비밀번호
ADMIN_PASSWORD=change-me

# 세션 쿠키 서명 키 (#27). 16자 이상 임의 문자열. 없으면 ADMIN_PASSWORD 에서 파생 (비밀번호 변경 = 전 세션 무효)
ADMIN_SESSION_SECRET=

# 로그인 화면에서 이름을 비웠을 때 감사 기록(admin_audit_log / face_verification_reviews.actor)에 남는 기본 처리자 이름
ADMIN_ACTOR_LABEL=admin-web
