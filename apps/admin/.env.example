# Supabase 프로젝트 (Settings → API) — service role key 는 서버 전용, 절대 공개 금지
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 관리자 로그인(비밀번호 · MFA)에 쓰는 공개 anon key (#27). 사용자 범위 GoTrue 호출용 — secret 아님
SUPABASE_ANON_KEY=your-anon-key

# 세션 쿠키 서명 키 (#27). production 필수 32자+. development 는 16자+ 또는 미설정 시 service role key 파생
ADMIN_SESSION_SECRET=

# 신뢰할 수 있는 리버스 프록시 뒤에서만 1 (로그인 제한 키에 x-forwarded-for 사용)
# ADMIN_TRUST_PROXY_HEADERS=1

# ── 전환 기간 한정 (#27) ─────────────────────────────────────────────────────
# 구 공유 비밀번호 로그인. 둘 다 있고 "MFA 로 로그인을 완료한 관리자가 아직 없을 때" 만 열린다. 첫 owner 가 MFA 로 로그인하면 자동으로 닫힌다.
# 전환이 끝나면 두 줄을 지운다.
# ADMIN_LEGACY_PASSWORD_LOGIN=1
# ADMIN_PASSWORD=
