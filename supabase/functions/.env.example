# Edge Function 서버 환경변수 예시 (로컬: supabase functions serve 용 .env)
# 원격 환경에는 `supabase secrets set KEY=VALUE` 로 설정한다.
# 실제 secret 값은 이 저장소에 절대 커밋하지 말 것. 목록/규칙: docs/environments.md

# 환경 구분 — development | staging | production
# 누락되거나 알 수 없는 값이면 서버는 production 으로 간주한다 (fail-closed).
# 로컬 개발에서는 반드시 development 로 설정해야 dev fixture/dev-login 을 쓸 수 있다.
APP_ENV=development

# 본인확인 identity_key_hash 용 HMAC secret.
#   development: 미설정 시 개발 fixture secret 사용 (seed.sql 해시와 일치)
#   staging/production: 32자 이상 고유 값 필수 (예: openssl rand -hex 32).
#                       미설정·개발 기본값·짧은 값이면 verify-identity 가 기동 자체를 거부한다.
# IDENTITY_HASH_SECRET=

# 본인확인 / 얼굴 인증 provider.
#   development/staging: 미설정 시 mock (verificationId 미검증·아무 6자리 코드 통과 — 개발 전용)
#   production: 실제 provider 이름 필수 — 미설정/mock/미구현 이름이면 함수가 기동 자체를 거부한다.
# IDENTITY_PROVIDER=mock
# FACE_VERIFICATION_PROVIDER=mock

# DEVELOPMENT/STAGING ONLY — dev-login 활성화 opt-in.
# production 에서는 이 값이 1 이어도 dev-login 이 무조건 403 이다.
ALLOW_DEV_LOGIN=1

# DEVELOPMENT/STAGING ONLY — dev-login 이 만드는 개발 계정의 비밀번호.
# 미설정 시 seed.sql 과 동일한 개발 기본값 사용. staging 에서는 고유 값 설정 권장.
# DEV_LOGIN_PASSWORD=

# DEVELOPMENT/STAGING ONLY — dev-login 에서 010-0000-XXXX 외 번호 허용 (기본: 테스트 대역만)
# DEV_LOGIN_ALLOW_ANY_PHONE=1

# 긴급 kill switch — 1 이면 환경과 무관하게 dev-login 차단
# DISABLE_DEV_LOGIN=1

# ── SMS OTP 실발송 (send-sms — Supabase Auth "Send SMS" HTTP Hook → SOLAPI, Issue #4) ──
# 네 값 모두 서버 전용 secret 이다. EXPO_PUBLIC_* / 클라이언트 번들 / 저장소에 절대 넣지 말 것.
# 하나라도 누락되거나 형식이 잘못되면 send-sms 는 모든 요청을 거부한다 (fail-closed → OTP 미발송).
# 로컬 개발에서는 보통 설정하지 않는다 — Dashboard Test OTP 로 실발송 없이 로그인한다.

# SOLAPI 콘솔 → API Key 관리에서 발급한 키/시크릿
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=

# SOLAPI 에 등록·승인된 발신번호. 숫자만 권장 (+, -, 공백은 서버가 제거) 예: 01012345678
# SOLAPI_SENDER_NUMBER=

# Supabase Dashboard → Authentication → Hooks → Send SMS 를 켜면 보여주는 hook secret.
# 형식: v1,whsec_<base64>  (secret 회전 중에는 `|` 로 여러 개 이어 붙일 수 있다)
# 이 값으로 Standard Webhooks 서명을 검증한다 — send-sms 는 JWT 없이(--no-verify-jwt) 배포되므로
# 이 검증이 유일한 호출자 인증이다.
# SEND_SMS_HOOK_SECRETS=
